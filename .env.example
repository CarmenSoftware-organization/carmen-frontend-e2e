# URL of the running frontend instance under test.
E2E_BASE_URL=http://localhost:3000

# Path to the frontend repo used for the Playwright webServer.
# Resolved relative to this project's root. Default: the React SPA (Vite, :3000),
# whose backend comes from its own public/config.json (no dev proxy needed).
E2E_FRONTEND_DIR=../carmen-frontend

# Set to "1" to disable Playwright's webServer and test against an already
# running instance (e.g. staging).
E2E_NO_WEBSERVER=0

# Google Sheets sync (optional) — used by `bun e2e:sync` to upsert test
# results from tests/results/*.csv back to a spreadsheet. Set these in
# .env.local (do NOT commit). See scripts/sync-test-results.ts header for
# the full setup procedure.
GOOGLE_SHEETS_SA_KEY_PATH=/absolute/path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Optional: route the SPA's /api through Vite's dev proxy ---
# Only needed if you blank out BACKEND_URL in the SPA's public/config.json (so
# requests hit /api instead of an absolute backend URL). Then give Vite a target:
#   VITE_DEV_PROXY_TARGET=http://localhost:4000
# (the SPA's `bun dev` inherits VITE_DEV_PROXY_TARGET from this process)

# --- Optional: frontend checkout under a different path ---
#   E2E_FRONTEND_DIR=../carmen-frontend

# --- Master seed (bun run seed:master) ---
# Backend + BU + credentials for scripts/seed-master. BACKEND_URL/X_APP_ID fall
# back to the frontend config.json when unset; the rest are required.
# SEED_BACKEND_URL=http://localhost:4000
# SEED_X_APP_ID=
SEED_BU_CODE=BLAVG
SEED_EMAIL=admin@blueledgers.com
SEED_PASSWORD=12345678
# SEED_CONFIG_PATH=../carmen-frontend/dist/config.json

# --- Named targets (bun run test:uat / test:prod / scripts/run-env.ts <name>) ---
# Create .env.<name> locally (gitignored). Its values override .env/.env.local.
# Minimal contents for a deployed frontend:
#   E2E_NO_WEBSERVER=1
#   E2E_BASE_URL=https://<deployed-frontend-host>

# --- Movement suite (opt-in: bun run test:movement / test:period-close) ---
# Runs on the CARMEN-AVG / CARMEN-FIFO tenant with the @carmen.com accounts in
# tests/movement-users.ts. Put the DB URL in .env.local, never in code; a
# read-only Postgres role is enough (the helpers only run SELECT).
# E2E_DB_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require
# Backend for direct API checks — falls back to the running frontend's /config.json:
# E2E_API_URL=https://<backend-host>
# E2E_X_APP_ID=
# Date for stock-posting documents — default: today if it is in the BU's current period, else its 15th:
# E2E_MOVEMENT_DATE=2026-07-15
# SR → Issue flow (721): E2E_SRI_BU=FIFO for the FIFO variant; E2E_SRI_PHASE=pre|post|all (AVG)
# Period close: scenario from tests/helpers/period-close/scenarios.ts, and the gate for the
# irreversible steps (count submit, Start, Close) as <BU>:<period>:
# E2E_PERIOD_SCENARIO=avg2607
# E2E_ALLOW_IRREVERSIBLE=CARMEN-AVG:2607
# E2E_EVIDENCE_DIR=runs/period-close/avg2607
