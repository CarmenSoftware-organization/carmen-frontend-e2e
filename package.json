{
  "name": "carmen-frontend-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for carmen-frontend",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:login": "playwright test --project=login",
    "test:chromium": "playwright test --project=chromium",
    "test:dev": "playwright test",
    "test:prod": "bun run scripts/run-env.ts prod",
    "test:uat": "bun run scripts/run-env.ts uat",
    "test:movement": "E2E_MOVEMENT=1 playwright test --project=movement",
    "test:period-close": "E2E_PERIOD_CLOSE=1 playwright test --project=period-close",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:login": "playwright test --project=login",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:dev": "playwright test",
    "e2e:prod": "bun run scripts/run-env.ts prod",
    "e2e:uat": "bun run scripts/run-env.ts uat",
    "e2e:report": "playwright show-report",
    "e2e:sync": "bun run scripts/sync-test-results.ts",
    "e2e:sync:reset": "bun run scripts/sync-test-results.ts --reset",
    "docs:user-stories": "bun run scripts/generate-user-stories.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "install-browsers": "playwright install --with-deps",
    "audit:tc-ids": "bun run scripts/audit-tc-ids.ts",
    "audit:tc-ids:legacy": "bun run scripts/audit-tc-ids.ts --legacy-mode",
    "audit:tc-ids:strict": "bun run scripts/audit-tc-ids.ts",
    "audit:tc-ids:lenient": "bun run scripts/audit-tc-ids.ts --lenient-docs",
    "audit:coverage": "bun run scripts/audit-coverage.ts",
    "audit:spec-health": "bun run scripts/audit-spec-health.ts",
    "audit:spec-health:check": "bun run scripts/audit-spec-health.ts --check",
    "audit:coverage:check": "bun run scripts/audit-coverage.ts --check",
    "migrate:tc-propose": "bun run scripts/migrate-tc-ids/propose.ts",
    "migrate:tc-apply": "bun run scripts/migrate-tc-ids/apply.ts",
    "migrate:tc-sheet": "bun run scripts/migrate-tc-ids/sync-sheet.ts",
    "wiki:seed": "bun run tests/wiki-screenshots/seed-manifest.ts",
    "wiki:coverage": "bun run tests/wiki-screenshots/coverage.ts",
    "wiki:sitemap": "bun run tests/wiki-screenshots/sitemap.ts",
    "wiki:probe": "playwright test --project=wiki-probe",
    "wiki:capture": "playwright test --project=wiki-screenshots",
    "seed:master": "bun run scripts/seed-master/index.ts",
    "create:sitemap:screen": "bun run scripts/capture-screens.ts",
    "test:unit:coverage": "vitest run --coverage",
    "movement:setup-workflows": "bun run scripts/movement/setup-workflows.ts",
    "movement:setup-fifo-roles": "bun run scripts/movement/setup-fifo-roles.ts",
    "movement:cleanup": "bun run scripts/movement/cleanup.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "4.1.9",
    "googleapis": "^171.4.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "vite": "8.0.16"
  }
}
